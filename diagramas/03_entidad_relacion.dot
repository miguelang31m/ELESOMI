digraph G { graph [rankdir=TB, bgcolor="white", pad="0.25"]; node [shape=record, style="filled", fillcolor="#EFF5FB", color="#7A9DBF", fontname="Arial", fontsize=11, fontcolor="#17395D"]; passenger [label="{PASAJERO|+ id : BIGSERIAL (PK)\l+ nombres : VARCHAR(80)\l+ apellidos : VARCHAR(80)\l+ tipo_documento : VARCHAR(3)\l+ numero_documento : VARCHAR(25)\l+ fecha_nacimiento : DATE\l+ correo : VARCHAR(120)\l+ telefono : VARCHAR(25)\l+ nacionalidad : VARCHAR(60)\l+ activo : BOOLEAN\l+ creado_en : TIMESTAMP\l+ actualizado_en : TIMESTAMP\l|UNIQUE(tipo_documento, numero_documento)\l}"]; }