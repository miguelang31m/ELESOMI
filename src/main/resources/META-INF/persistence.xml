<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence" version="2.1">
  <persistence-unit name="aerolineaPU" transaction-type="JTA">
    <jta-data-source>jdbc/AerolineaDS</jta-data-source>
    <class>co.edu.aerolinea.pasajeros.modelo.Pasajero</class>
    <properties>
      <property name="eclipselink.ddl-generation" value="none"/>
      <property name="eclipselink.logging.level" value="WARNING"/>
    </properties>
  </persistence-unit>
</persistence>
